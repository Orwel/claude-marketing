# Carpeta de Drive sincronizada por Google Drive para escritorio.
# Dentro hay una carpeta por mes ("2026-10 octubre") con "videos grabados"
# (lo que tu subes) y "videos editados" (lo que sale de aqui).
# Si se deja vacia, los renders quedan en salida/AAAA-MM/.
CARPETA_REDES=G:\Mi unidad\Redes sociales

# Nombres de las subcarpetas del mes. Solo cambialos si renombras en Drive.
SUBCARPETA_GRABADOS=videos grabados
SUBCARPETA_EDITADOS=videos editados

# Opcional: reutiliza un Chrome ya instalado en vez de que Remotion baje otro.
CHROME_EJECUTABLE=

# --- Voz clonada (entrega 3, opcional) ---
# Solo para narrar videos animados sin grabar. Lo que lleva tu cara va con tu
# voz grabada. Clave: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Id de TU voz clonada. Una voz de stock resta credibilidad.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2

# --- B-roll de archivo (opcional) ---
# Clips gratis de Pexels, uso comercial sin atribucion, para cubrir cortes.
# Clave gratuita en https://www.pexels.com/api/  (200 peticiones/hora)
PEXELS_API_KEY=
