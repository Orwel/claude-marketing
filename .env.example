# --- IA (Google Gemini) ---
# Consigue la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo. "npm run probar" lista los que tu clave tiene disponibles.
# Por defecto gemini-2.5-pro (estable). Si tu cuenta ya tiene Gemini 3,
# usa ese: da mejores guiones.
MODELO_IA=gemini-2.5-pro

# Profundidad de razonamiento: low | medium | high
# En Gemini 2.5 se traduce a thinkingBudget, en Gemini 3 a thinkingLevel.
ESFUERZO_IA=high

# --- Voz (ElevenLabs) ---
# Clave: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Id de la voz. "npm run probar" lista las de tu cuenta.
# Para marca personal, clona TU voz: una voz de stock se nota y resta.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2

# --- Video ---
# plantilla = texto animado sobre los colores de marca (gratis, instantaneo)
# imagen    = fondo generado por escena con Imagen (barato)
# veo       = clip de video por escena con Veo (caro y lento, pero es video real)
# stock = clips reales de Pexels: gratis, uso comercial, sin atribucion.
# Es la alternativa barata a Veo y para planos ambientales no se nota.
MODO_FONDO=plantilla
# Clave gratuita en https://www.pexels.com/api/  (200 peticiones/hora)
PEXELS_API_KEY=
MODELO_VEO=veo-3.1-fast-generate-preview
MODELO_IMAGEN=imagen-4.0-generate-001
VEO_ESPERA_MAX_MIN=15
# Opcional: reutiliza un Chrome ya instalado en vez de que Remotion baje otro
CHROME_EJECUTABLE=

# --- Almacenamiento del video ---
# Blotato DESCARGA el video desde una URL publica: no acepta subida directa.
# Sin esto configurado no hay publicacion automatica posible.
#   manual   = lo subes tu y pasas la URL con --video
#   supabase = bucket PUBLICO de Supabase Storage
#   r2       = Cloudflare R2 u otro S3 compatible
ALMACENAMIENTO=manual
BUCKET=reels

# Si ALMACENAMIENTO=supabase (usa un proyecto aparte del de produccion)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Si ALMACENAMIENTO=r2
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_URL_PUBLICA=

# --- Blotato (publicacion multiplataforma) ---
# Panel: https://my.blotato.com -> Settings -> API
BLOTATO_API_KEY=
BLOTATO_BASE_URL=https://backend.blotato.com
# ID de la cuenta conectada en Blotato (lo obtienes con: npm run probar)
BLOTATO_ACCOUNT_ID_INSTAGRAM=

# --- Instagram Graph API (solo lectura de metricas) ---
# Token de larga duracion de la app de Meta con permisos
# instagram_basic + instagram_manage_insights
IG_ACCESS_TOKEN=
# ID de la cuenta profesional de Instagram (no el @usuario)
IG_USER_ID=
IG_API_VERSION=v22.0

# --- Operacion ---
# Cuantas publicaciones planifica por dia
PUBLICACIONES_POR_DIA=1
# Modo simulacion: no publica nada, solo imprime lo que haria
SIMULAR=true
